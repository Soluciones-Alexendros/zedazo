{
  "name": "zedazo-web",
  "version": "0.5.0-draft",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "tokens:build": "node scripts/design-tokens/build.mjs",
    "tokens:check": "node scripts/design-tokens/build.mjs --check",
    "tokens:contrast": "node scripts/design-tokens/contrast.mjs",
    "test": "node --test src/**/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:real-api": "bash scripts/e2e-real-api.sh",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "pnpm": {
    "ignoredBuiltDependencies": ["unrs-resolver"],
    "overrides": {
      "postcss": "8.5.31",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12"
    }
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.12.0",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/react-virtual": "^3.11.3",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "typescript": "^5.7.3"
  }
}
