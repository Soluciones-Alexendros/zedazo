{
  "name": "zedazo-web",
  "version": "0.5.1",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "node scripts/serve-out.mjs",
    "lint": "next lint",
    "test": "DS_REFERENCES_CSS=src/design-system/design-references.css node --test src/**/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:real-api": "bash scripts/e2e-real-api.sh",
    "test:e2e:api-serves-gui": "bash scripts/e2e-api-serves-gui.sh",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": "8.5.31",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12"
    }
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "typescript": "^5.7.3"
  }
}
