{
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": { "value": 120, "unit": "ms" },
        "$extensions": { "com.zedazo": { "cssVar": "--zed-transition-fast" } }
      },
      "base": {
        "$value": { "value": 180, "unit": "ms" },
        "$extensions": { "com.zedazo": { "cssVar": "--zed-transition-base" } }
      },
      "slow": {
        "$value": { "value": 260, "unit": "ms" },
        "$extensions": { "com.zedazo": { "cssVar": "--zed-transition-slow" } }
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [0.2, 0, 0, 1],
        "$extensions": { "com.zedazo": { "cssVar": "--zed-ease-standard" } }
      }
    }
  }
}
