{
  "$description": "Color semántico — tema claro. Nombres públicos --zed-* estables (fase 1, sin rename).",
  "$extensions": { "com.zedazo": { "theme": "light" } },
  "color": {
    "bg": {
      "canvas": {
        "$type": "color",
        "$value": "{color.paper.50}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-bg-canvas" } }
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.paper.100}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-bg-subtle" } }
      },
      "muted": {
        "$type": "color",
        "$value": "{color.paper.200}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-bg-muted" } }
      },
      "raised": {
        "$type": "color",
        "$value": "{color.paper.0}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-bg-raised" } }
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.ink.fg-strong}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-bg-inverse" } }
      },
      "overlay": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.18, 0.04, 258], "alpha": 0.45 },
        "$description": "Scrim de overlay/drawer. Mismo valor en claro y oscuro (fase 2).",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-overlay" } }
      }
    },
    "fg": {
      "strong": {
        "$type": "color",
        "$value": "{color.ink.fg-strong}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-fg-strong" } }
      },
      "default": {
        "$type": "color",
        "$value": "{color.ink.fg-default}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-fg-default" } }
      },
      "muted": {
        "$type": "color",
        "$value": "{color.ink.fg-muted}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-fg-muted" } }
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.ink.fg-subtle}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-fg-subtle" } }
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.paper.75}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-fg-inverse" } }
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.paper.300}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-border-subtle" } }
      },
      "default": {
        "$type": "color",
        "$value": "{color.paper.400}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-border-default" } }
      },
      "strong": {
        "$type": "color",
        "$value": "{color.ink.border-strong}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-border-strong" } }
      }
    },
    "accent": {
      "default": {
        "$type": "color",
        "$value": "{color.accent.500}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-accent" } }
      },
      "hover": {
        "$type": "color",
        "$value": "{color.accent.600}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-accent-hover" } }
      },
      "active": {
        "$type": "color",
        "$value": "{color.accent.700}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-accent-active" } }
      },
      "soft": {
        "$type": "color",
        "$value": "{color.accent.soft-light}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-accent-soft" } }
      },
      "on": {
        "$type": "color",
        "$value": "{color.paper.50}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-accent-on" } }
      },
      "border": {
        "$type": "color",
        "$value": { "colorSpace": "oklch", "components": [0.53, 0.16, 257], "alpha": 0.28 },
        "$description": "Borde de callout privacy/tabs; equivalente a color-mix(accent 28%, transparent)",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-accent-border" } }
      }
    },
    "success": {
      "default": {
        "$type": "color",
        "$value": "{color.success.600}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-success" } }
      },
      "hover": {
        "$type": "color",
        "$value": "{color.success.700}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-success-hover" } }
      },
      "soft": {
        "$type": "color",
        "$value": "{color.success.soft-light}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-success-soft" } }
      },
      "onSoft": {
        "$type": "color",
        "$value": "{color.success.on-soft-light}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-success-on-soft" } }
      }
    },
    "warning": {
      "default": {
        "$type": "color",
        "$value": "{color.warning.600}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-warning" } }
      },
      "hover": {
        "$type": "color",
        "$value": "{color.warning.700}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-warning-hover" } }
      },
      "soft": {
        "$type": "color",
        "$value": "{color.warning.soft-light}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-warning-soft" } }
      },
      "onSoft": {
        "$type": "color",
        "$value": "{color.warning.on-soft-light}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-warning-on-soft" } }
      }
    },
    "danger": {
      "default": {
        "$type": "color",
        "$value": "{color.danger.600}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-danger" } }
      },
      "hover": {
        "$type": "color",
        "$value": "{color.danger.700}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-danger-hover" } }
      },
      "soft": {
        "$type": "color",
        "$value": "{color.danger.soft-light}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-danger-soft" } }
      },
      "onSoft": {
        "$type": "color",
        "$value": "{color.danger.on-soft-light}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-danger-on-soft" } }
      }
    },
    "info": {
      "default": {
        "$type": "color",
        "$value": "{color.info.600}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-info" } }
      },
      "hover": {
        "$type": "color",
        "$value": "{color.info.700}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-info-hover" } }
      },
      "soft": {
        "$type": "color",
        "$value": "{color.info.soft-light}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-info-soft" } }
      },
      "onSoft": {
        "$type": "color",
        "$value": "{color.info.on-soft-light}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-info-on-soft" } }
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{color.accent.focus-light}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-focus-ring" } }
      }
    },
    "selection": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.selection-light}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-selection-bg" } }
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.selection-fg-light}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-selection-fg" } }
      }
    },
    "code": {
      "bg": {
        "$type": "color",
        "$value": "{color.ink.550}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-code-bg" } }
      },
      "fg": {
        "$type": "color",
        "$value": "{color.paper.code}",
        "$extensions": { "com.zedazo": { "cssVar": "--zed-code-fg" } }
      }
    },
    "badge": {
      "success": {
        "border": {
          "$type": "color",
          "$value": { "colorSpace": "oklch", "components": [0.48, 0.115, 157], "alpha": 0.32 },
          "$description": "Equivalente a color-mix(success 32%, transparent)",
          "$extensions": { "com.zedazo": { "cssVar": "--zed-badge-success-border" } }
        }
      },
      "warning": {
        "border": {
          "$type": "color",
          "$value": { "colorSpace": "oklch", "components": [0.58, 0.13, 78], "alpha": 0.35 },
          "$extensions": { "com.zedazo": { "cssVar": "--zed-badge-warning-border" } }
        }
      },
      "danger": {
        "border": {
          "$type": "color",
          "$value": { "colorSpace": "oklch", "components": [0.52, 0.16, 25], "alpha": 0.32 },
          "$extensions": { "com.zedazo": { "cssVar": "--zed-badge-danger-border" } }
        }
      },
      "info": {
        "border": {
          "$type": "color",
          "$value": { "colorSpace": "oklch", "components": [0.53, 0.105, 228], "alpha": 0.3 },
          "$extensions": { "com.zedazo": { "cssVar": "--zed-badge-info-border" } }
        }
      }
    }
  }
}
