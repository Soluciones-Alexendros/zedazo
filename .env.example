# Variables de entorno de zedazo (plantilla)
#
# Copia a `.env` y ajusta. `.env` NO se versiona (ver .gitignore).
# Nunca pongas valores reales en este fichero de ejemplo.
#
# Documentación: docs/gui/deploy.md, docs/gui/retention.md, docs/desktop.md,
# SECURITY.md. Los valores por defecto son los del binario/API.

# ── API y bind ────────────────────────────────────────────────────────────────
# Bind de la API. Loopback por defecto; remoto solo tras HTTPS (ADR-0016).
ZEDAZO_BIND=127.0.0.1:8080
# ¿Sirve la API? true = operativa.
ZEDAZO_API_ENABLED=true
# ¿Sirve el frontend estático? false = la GUI se sirve aparte (Caddy/Next).
ZEDAZO_WEB_ENABLED=false
# Directorio de la GUI estática cuando la sirve la API (ADR-0021/desktop).
# ZEDAZO_STATIC_DIR=apps/web/out
# Orígenes CORS explícitos (coma-separados). Vacío = sin CORS permisivo.
ZEDAZO_CORS_ORIGIN=
# Host allowlist adicional (coma-separados); loopback siempre permitido.
ZEDAZO_ALLOWED_HOSTS=

# ── Datos y retención ─────────────────────────────────────────────────────────
# Raíz de datos (jobs/, uploads/, tmp/).
ZEDAZO_DATA_DIR=/var/lib/zedazo
# ephemeral = FS + manifest.json (sin base de datos).
ZEDAZO_STORAGE_MODE=ephemeral
# TTL tras estado terminal (hours).
ZEDAZO_JOB_RETENTION_HOURS=24
# Tope de jobs no terminales; 0 desactiva el límite.
ZEDAZO_MAX_CONCURRENT_JOBS=4
# Timeout de ejecución de un job (segundos). Sin definir = sin límite.
# ZEDAZO_JOB_TIMEOUT_SECS=300
# TTL de uploads temporales (hours).
ZEDAZO_UPLOAD_TTL_HOURS=24
# Límite de subida en bytes (50 MiB).
ZEDAZO_MAX_UPLOAD_BYTES=52428800

# ── Autenticación ─────────────────────────────────────────────────────────────
# disabled = solo loopback (fail-closed fuera de él); token = remoto (ADR-0016).
ZEDAZO_AUTH_MODE=disabled
# Obligatorio si ZEDAZO_AUTH_MODE=token. Alta entropía; NO commitear.
# ZEDAZO_AUTH_TOKEN=
# Solo Docker local: API escucha 0.0.0.0 dentro del contenedor.
ZEDAZO_AUTH_ALLOW_DISABLED_NON_LOOPBACK=false
# Cookie `Secure`; false solo para pruebas HTTP locales con token.
ZEDAZO_AUTH_COOKIE_SECURE=true

# ── Observabilidad ────────────────────────────────────────────────────────────
# Opt-in (docs/otel.md).
ZEDAZO_OTEL_ENABLED=false

# ── CardDAV (opt-in, ADR-0018) ────────────────────────────────────────────────
# Credenciales por entorno; la contraseña de app nunca se versiona.
# ZEDAZO_CARDDAV_URL=https://cloud.example.com/remote.php/dav
# ZEDAZO_CARDDAV_USERNAME=usuario
# ZEDAZO_CARDDAV_PASSWORD=
# ZEDAZO_CARDDAV_ADDRESSBOOK=contacts
