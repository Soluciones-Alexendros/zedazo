#!/bin/sh
# Pre-commit hook: formatea, verifica lint, tests y docs antes de cada commit.

set -eu

echo "→ cargo fmt --all -- --check"
cargo fmt --all -- --check || {
    echo "⚠️  Formato incorrecto. Ejecuta 'cargo fmt --all' y vuelve a intentar."
    exit 1
}

# zedazo-desktop (Tauri/GTK) fuera del gate local sin WebKit; CI Desktop* lo cubre.
echo "→ cargo clippy --workspace --all-targets --all-features --exclude zedazo-desktop -- -D warnings"
cargo clippy --workspace --all-targets --all-features --exclude zedazo-desktop -- -D warnings || {
    echo "⚠️  Clippy encontró problemas."
    exit 1
}

echo "→ cargo check --workspace --all-features --exclude zedazo-desktop"
cargo check --workspace --all-features --exclude zedazo-desktop || {
    echo "⚠️  cargo check falló."
    exit 1
}

echo "→ cargo test --workspace --lib --all-features --exclude zedazo-desktop"
cargo test --workspace --lib --all-features --exclude zedazo-desktop || {
    echo "⚠️  Tests unitarios fallaron."
    exit 1
}

echo "→ make docs-validate"
make docs-validate || {
    echo "⚠️  Validación de docs falló."
    exit 1
}

echo "✓ Pre-commit OK"
