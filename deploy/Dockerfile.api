# API Zedazo
# Imagen de build ≥ 1.85 (deps con edition2024). MSRV del crate sigue en 1.80 (CI msrv).
# Digests resueltos 2026-10-26 (docker buildx imagetools inspect).
FROM rust:1.85-bookworm@sha256:e51d0265072d2d9d5d320f6a44dde6b9ef13653b035098febd68cce8fa7c0bc4 AS build
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
# Miembro del workspace (Cargo.toml); no se compila zedazo-desktop aquí (sin GTK).
COPY apps/desktop/Cargo.toml apps/desktop/Cargo.toml
COPY apps/desktop/build.rs apps/desktop/build.rs
COPY apps/desktop/src apps/desktop/src
COPY apps/desktop/tauri.conf.json apps/desktop/tauri.conf.json
COPY apps/desktop/capabilities apps/desktop/capabilities
COPY apps/desktop/icons apps/desktop/icons
RUN cargo build -p zedazo-api --release --locked

FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
RUN useradd -r -u 10001 zedazo && mkdir -p /var/lib/zedazo && chown zedazo:zedazo /var/lib/zedazo
COPY --from=build /app/target/release/zedazo-api /usr/local/bin/zedazo-api
USER zedazo
ENV ZEDAZO_BIND=0.0.0.0:8080 \
    ZEDAZO_DATA_DIR=/var/lib/zedazo \
    ZEDAZO_STORAGE_MODE=ephemeral \
    ZEDAZO_AUTH_MODE=disabled \
    ZEDAZO_OTEL_ENABLED=false
EXPOSE 8080
VOLUME ["/var/lib/zedazo"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD ["zedazo-api", "--health-check"]
CMD ["zedazo-api"]
